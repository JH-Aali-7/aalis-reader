<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AaliReader" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/purple_100</item>
        <item name="colorOnPrimaryContainer">@color/purple_900</item>

        <item name="colorSecondary">@color/purple_600</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/purple_200</item>
        <item name="colorOnSecondaryContainer">@color/purple_900</item>

        <item name="colorTertiary">@color/accent_pink</item>
        <item name="colorOnTertiary">@color/white</item>

        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/on_surface_light</item>
        <item name="colorSurfaceVariant">@color/purple_50</item>
        <item name="colorOnSurfaceVariant">@color/purple_800</item>
        <item name="colorOutline">@color/outline_light</item>

        <item name="android:statusBarColor">@color/purple_700</item>
        <item name="android:navigationBarColor">@color/purple_700</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- every dialog in the app uses these, so buttons are always readable -->
        <item name="materialAlertDialogTheme">@style/Theme.AaliReader.Dialog</item>
        <item name="alertDialogTheme">@style/Theme.AaliReader.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.AaliReader.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/Theme.AaliReader.BottomSheet</item>
        <item name="android:textColorPrimary">@color/on_surface_light</item>
    </style>

    <!-- High contrast dialogs: filled purple positive button, bold purple text buttons -->
    <style name="Theme.AaliReader.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/purple_600</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/on_surface_light</item>
        <item name="android:textColorPrimary">@color/on_surface_light</item>
        <item name="android:textColorSecondary">@color/on_surface_light</item>
        <item name="buttonBarPositiveButtonStyle">@style/AaliDialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/AaliDialog.Button.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/AaliDialog.Button.Text</item>
        <item name="materialAlertDialogTitleTextStyle">@style/AaliDialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/AaliDialog.Body</item>
        <item name="shapeAppearanceOverlay">@style/AaliDialog.Shape</item>
    </style>

    <style name="Theme.AaliReader.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorPrimary">@color/purple_600</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/on_surface_light</item>
    </style>
</resources>
