<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bar_gradient"
        app:title=""
        app:titleTextColor="@color/white"
        app:subtitleTextColor="#E4D8FF"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium" />

    <com.aali.ebookreader.ReaderWebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bar_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp">

        <ImageButton
            android:id="@+id/btnContents"
            style="@style/ReaderBarButton"
            android:contentDescription="@string/contents"
            android:src="@drawable/ic_list" />

        <ImageButton
            android:id="@+id/btnPrev"
            style="@style/ReaderBarButton"
            android:contentDescription="Previous chapter"
            android:src="@drawable/ic_prev" />

        <TextView
            android:id="@+id/txtPage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#F0E7FF"
            android:textSize="12sp"
            android:text="" />

        <ImageButton
            android:id="@+id/btnNext"
            style="@style/ReaderBarButton"
            android:contentDescription="Next chapter"
            android:src="@drawable/ic_next" />

        <ImageButton
            android:id="@+id/btnTts"
            style="@style/ReaderBarButton"
            android:contentDescription="@string/read_aloud"
            android:src="@drawable/ic_speaker" />

        <ImageButton
            android:id="@+id/btnAuto"
            style="@style/ReaderBarButton"
            android:contentDescription="Auto scroll"
            android:src="@drawable/ic_play" />

        <ImageButton
            android:id="@+id/btnDisplay"
            style="@style/ReaderBarButton"
            android:contentDescription="@string/display"
            android:src="@drawable/ic_format" />
    </LinearLayout>
</LinearLayout>
